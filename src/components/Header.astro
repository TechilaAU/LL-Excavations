---
import { hubs, byHub } from '../data/services';
import { site } from '../data/site';
const hubKeys = Object.keys(hubs) as (keyof typeof hubs)[];
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a href="/" class="hdr__logo" aria-label="L&L Excavations home">
      <img src="/brand/LL_logo_horizontal_reversed.svg" alt="L&L Excavations" width="220" height="42" />
    </a>
    <nav class="hdr__nav" aria-label="Main">
      <div class="mega">
        <a href="/services/" class="hdr__link">Services</a>
        <div class="mega__panel">
          {hubKeys.map((h) => (
            <div>
              <a class="mega__hub" href={`/services/${h}/`}>{hubs[h].name}</a>
              <ul>{byHub(h).filter((s) => s.slug !== h).map((s) => <li><a href={`/services/${h}/${s.slug}/`}>{s.name}</a></li>)}</ul>
            </div>
          ))}
        </div>
      </div>
      <a href="/services/concreting/" class="hdr__link">Concreting</a>
      <a href="/service-areas/" class="hdr__link">Service Areas</a>
      <a href="/projects/" class="hdr__link">Projects</a>
      <a href="/about/" class="hdr__link">About</a>
    </nav>
    <div class="hdr__cta">
      <a href={site.phoneHref} class="hdr__phone">{site.phone}</a>
      <a href="/get-a-quote/" class="btn btn--amber">Get a quote</a>
    </div>
    <details class="mnav">
      <summary aria-label="Menu"><span></span><span></span><span></span></summary>
      <div class="mnav__panel">
        {hubKeys.map((h) => (
          <details>
            <summary>{hubs[h].name}</summary>
            <ul>
              <li><a href={`/services/${h}/`}>All {hubs[h].name.toLowerCase()}</a></li>
              {byHub(h).filter((s) => s.slug !== h).map((s) => <li><a href={`/services/${h}/${s.slug}/`}>{s.name}</a></li>)}
            </ul>
          </details>
        ))}
        <a href="/service-areas/">Service areas</a>
        <a href="/projects/">Projects</a>
        <a href="/about/">About</a>
        <a href="/faq/">FAQ</a>
        <a href="/contact/">Contact</a>
      </div>
    </details>
  </div>
</header>
<style>
  .hdr { background: var(--basalt); color: var(--chalk); position: sticky; top: 0; z-index: 50; }
  .hdr__in { display: flex; align-items: center; gap: 1.5rem; min-height: 4.5rem; }
  .hdr__logo img { width: 190px; }
  .hdr__nav, .hdr__cta { display: none; }
  .hdr__link { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; text-decoration: none; padding: 1.5rem 0.2rem; }
  .hdr__link:hover { color: var(--amber); }
  .hdr__phone { font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; text-decoration: none; }
  .mega { position: relative; }
  .mega__panel {
    position: absolute; left: -1.5rem; top: 100%; display: none; grid-template-columns: repeat(3, 15rem); gap: 2rem;
    background: var(--basalt); padding: 1.5rem 2rem 2rem; border-top: 3px solid var(--amber);
  }
  .mega:hover .mega__panel, .mega:focus-within .mega__panel { display: grid; }
  .mega__hub { font-family: var(--font-display); font-size: 1.4rem; font-weight: 800; text-transform: uppercase; color: var(--amber); text-decoration: none; }
  .mega ul { list-style: none; padding: 0; margin: 0.6rem 0 0; display: grid; gap: 0.35rem; font-size: 0.95rem; }
  .mega ul a { text-decoration: none; opacity: 0.85; } .mega ul a:hover { opacity: 1; color: var(--amber); }
  .mnav { margin-left: auto; }
  .mnav > summary { list-style: none; cursor: pointer; width: 48px; height: 48px; display: grid; place-content: center; gap: 5px; }
  .mnav > summary::-webkit-details-marker { display: none; }
  .mnav > summary span { width: 26px; height: 3px; background: var(--chalk); display: block; }
  .mnav__panel { position: absolute; left: 0; right: 0; top: 4.5rem; background: var(--basalt); padding: 1rem var(--gutter) 2rem; display: grid; max-height: calc(100vh - 4.5rem); overflow-y: auto; border-top: 3px solid var(--amber); }
  .mnav__panel a, .mnav__panel summary { display: block; padding: 0.9rem 0; font-family: var(--font-display); font-size: 1.35rem; font-weight: 700; text-decoration: none; border-bottom: 1px solid rgba(255,255,255,0.1); cursor: pointer; }
  .mnav__panel ul { list-style: none; padding: 0 0 0 1rem; margin: 0; }
  .mnav__panel ul a { font-family: var(--font-body); font-size: 1rem; font-weight: 500; padding: 0.7rem 0; }
  @media (min-width: 1000px) {
    .hdr__logo img { width: 220px; }
    .hdr__nav { display: flex; align-items: center; gap: 1.4rem; }
    .hdr__cta { display: flex; align-items: center; gap: 1.2rem; margin-left: auto; }
    .mnav { display: none; }
  }
</style>
